# Supabase (public storefront keys — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role — SERVER ONLY, never expose to browser/client.
# Only used by seed scripts / server-side admin tooling (Phase 2).
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_NAME=Kares Studio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp checkout destination (store number, digits only, e.g. 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=
